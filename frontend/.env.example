# Public URL of the Go API (used by the browser)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional internal URL for server-side rendering (e.g. http://api:8080 in docker compose)
API_URL=
# Public storefront URL (sitemap, RSS, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show the bundled demo catalogue & blog when the API/database is down or empty (set false in production)
NEXT_PUBLIC_DEMO_FALLBACK=true
