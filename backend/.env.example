# --- Core ---
PORT=8080
APP_ENV=development
# Supabase → Project Settings → Database → Connection string (URI).
# Session pooler (port 5432) or direct connection recommended; the transaction pooler (6543) also works.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
AUTO_MIGRATE=true

# Storefront origin(s) allowed by CORS, comma separated
ALLOWED_ORIGINS=http://localhost:3000
# Public storefront URL (used for payment callbacks and WhatsApp order links)
FRONTEND_URL=http://localhost:3000

# First admin account (created on startup only if no admin exists)
ADMIN_EMAIL=admin@chrismooredecor.com
ADMIN_PASSWORD=change-me-now

# --- Payments (leave blank to hide that option at checkout) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
# Set the same value under Flutterwave Dashboard → Settings → Webhooks → Secret hash
FLUTTERWAVE_SECRET_HASH=

# --- Optional: WhatsApp Cloud API alert to the owner on every new order ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=

# --- Optional: product image uploads to Supabase Storage (public bucket) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images
