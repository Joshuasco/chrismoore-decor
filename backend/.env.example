# --- Core ---
PORT=8080
APP_ENV=development
# Supabase → Project Settings → Database → Connection string (URI).
# Session pooler (port 5432) or direct connection recommended; the transaction pooler (6543) also works.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
AUTO_MIGRATE=true

# Storefront origin(s) allowed by CORS, comma separated
ALLOWED_ORIGINS=http://localhost:3000
# Public storefront URL (used for payment callbacks and WhatsApp order links)
FRONTEND_URL=http://localhost:3000

# First admin account (created on startup only if no admin exists)
ADMIN_EMAIL=admin@chrismooredecor.com
ADMIN_PASSWORD=change-me-now

# --- Payments (leave blank to hide that option at checkout) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
# Set the same value under Flutterwave Dashboard → Settings → Webhooks → Secret hash
FLUTTERWAVE_SECRET_HASH=

# --- Optional: WhatsApp Cloud API (owner alert on every new order; also used for customer messages below) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=

# --- Optional: send customers their order link + status updates ---
# Each channel turns on when its keys are filled in. Customers get a message when an
# order is placed, paid, confirmed, shipped, delivered or cancelled.
#
# Email (any SMTP service: Brevo, Resend, Zoho, Gmail app password, SES…).
# Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Chris Moore Interior Decor <orders@yourdomain.com>"
EMAIL_REPLY_TO=
#
# SMS via Termii (termii.com). Use the API key, an approved Sender ID and the
# base URL shown on your Termii dashboard. "dnd" also reaches DND numbers.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=dnd
#
# WhatsApp message to the customer. Needs WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID above
# and an approved Utility template with 4 body variables (see README).
WHATSAPP_CUSTOMER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# --- Optional: product image uploads to Supabase Storage (public bucket) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

# Swagger UI at /docs (defaults to on, except when APP_ENV=production)
# DOCS_ENABLED=true
